{
  "name": "archive-demo-nav",
  "version": "1.0.0",
  "private": true,
  "description": "本地档案系统演示导航台：Express + Playwright 自动登录",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "check": "node scripts/check-readiness.js",
    "check:network": "node scripts/check-readiness.js --network",
    "check:public": "node scripts/check-readiness.js --public",
    "pages:build": "node scripts/build-pages.js",
    "export:source": "node scripts/export-source.js"
  },
  "engines": { "node": ">=20" },
  "dependencies": {
    "express": "^5.1.0",
    "playwright": "^1.55.0"
  }
}
